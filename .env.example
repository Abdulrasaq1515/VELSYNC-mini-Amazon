# Database - MongoDB Connection
# Get your MongoDB connection string from MongoDB Atlas or use local MongoDB
MONGODB_URI=mongodb://localhost:27017/your-database-name

# NextAuth Configuration
# Set this to your domain in production (e.g., https://yourdomain.com)
NEXTAUTH_URL=http://localhost:3000
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-minimum-32-characters-long

# Stripe Payment Configuration
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Get webhook secret from Stripe CLI or Dashboard webhook settings
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Cloudinary Image Storage
# Get these from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Admin Configuration
# Set the email address for the admin user
ADMIN_EMAIL=admin@yourdomain.com

# Application URL
# Set this to your domain in production
NEXT_PUBLIC_APP_URL=http://localhost:3000